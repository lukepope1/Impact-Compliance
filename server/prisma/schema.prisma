// NMTC Compliance Platform — Phase 1 canonical data model
// 1:1 translation of NMTC_Phase_1_Database_Schema.sql into Prisma.
// This schema is standalone: no relation to the Impact Marketplace CRM's Prisma schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


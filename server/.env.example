# Postgres connection for the compliance platform's own database.
# Must NOT point at the CRM database — this product owns a separate schema entirely.
# Local dev uses the self-contained embedded Postgres started by `npm run db:local`:
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/nmtc_compliance?schema=public"

PORT=4100
CLIENT_ORIGIN="http://localhost:5173"

# Secret used to sign login JWTs — generate a long random string for anything beyond
# local dev, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# The server refuses to start at all (any environment) if this is under 32 chars or
# contains "dev" — including this placeholder, which is intentionally rejected rather than
# silently usable. This is an interim local-credential auth system (see
# server/src/routes/auth.ts) standing in for a real identity provider — AWS Cognito or
# equivalent, per the schema's original implementation notes — which is the eventual
# swap-out, not a permanent design choice.
JWT_SECRET="change-this-to-a-long-random-string-for-anything-but-local-dev"

# S3 evidence storage (private bucket, SSE-KMS). Local dev uses a disk-backed stand-in
# (see server/src/lib/storage.ts) when EVIDENCE_S3_BUCKET is unset — leave all three blank
# for local dev. Setting EVIDENCE_S3_BUCKET switches to real S3 automatically; see
# docs/AWS_SETUP.md for provisioning the bucket/KMS key (infra/evidence-bucket.yaml) and
# what IAM permissions the server's role needs. AWS credentials themselves are never read
# from here — they come from the standard AWS credential chain (IAM role, or
# AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars / ~/.aws/credentials locally).
AWS_REGION=""
EVIDENCE_S3_BUCKET=""
EVIDENCE_KMS_KEY_ARN=""

# Malware scanning (ClamAV/clamd, see server/src/lib/scanner.ts and
# docs/MALWARE_SCANNING.md). Leave CLAMAV_HOST unset to disable scanning — uploads then
# stay "pending" and are undownloadable rather than being assumed clean. Set it once clamd
# is reachable (localhost for a local install, a sidecar/service host in a real deployment).
CLAMAV_HOST=""
CLAMAV_PORT=3310

# Email delivery for notifications (see server/src/lib/email.ts and
# docs/NOTIFICATIONS.md). Leave SMTP_HOST unset to disable email — in-app notifications
# still work either way; email notification rows are just recorded as "failed" instead of
# sent. SMTP_FROM should be a domain you actually control once this is real.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@nmtc-compliance.example"

  submittedByUserId          String            @map("submitted_by_user_id")
  submittedByUser            User              @relation("SubmittedByUser", fields: [submittedByUserId], references: [id])
  attestedByUserId           String?           @map("attested_by_user_id")
  attestedByUser              User?             @relation("AttestedByUser", fields: [attestedByUserId], references: [id])
  attestationText              String?           @map("attestation_text")
  attestedAt                     DateTime?         @map("attested_at")
  submittedAt                      DateTime?         @map("submitted_at")
  status                              SubmissionStatus  @default(draft)
  responseNote                          String?           @map("response_note")
  createdAt                               DateTime          @default(now()) @map("created_at")

  documents  SubmissionDocument[]
  reviews    Review[]
  comments   Comment[]

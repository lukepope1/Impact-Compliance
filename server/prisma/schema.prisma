// ---------- Identity & Tenancy ----------

model Organization {
  id               String           @id @default(uuid())
  organizationType OrganizationType @map("organization_type")
  legalName        String           @map("legal_name")
  displayName      String?          @map("display_name")
  einLast4         String?          @map("ein_last4")
  status           OrgStatus        @default(active)
  settings         Json             @default("{}")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  memberships           OrganizationMembership[]
  dealAccess             DealOrganizationAccess[]
  dealParties            DealParty[]
  cdeParticipations      CdeParticipation[]                @relation("CdeOrg")
  allocateeParticipations CdeParticipation[]               @relation("AllocateeOrg")
  ownedDocuments         Document[]
  documentAccessGrants   DocumentAccessGrant[]
  comments               Comment[]
  messages               Message[]
  assignedIssues         Issue[]
  issueNotes             IssueNote[]
  notifications          Notification[]
  auditEvents            AuditEvent[]

  @@map("organizations")
}

model User {
  id                 String     @id @default(uuid())
  externalAuthSubject String    @unique @map("external_auth_subject")
  email              String     @unique
  // bcrypt hash for the interim local-credential login (see server/src/routes/auth.ts).
  // Null for users provisioned only through a future real IdP (AWS Cognito or
  // equivalent per the schema's original implementation notes) once that's wired up —
  // this column is the swap-out point, not a permanent design choice.
  passwordHash       String?    @map("password_hash")
  firstName          String?    @map("first_name")
  lastName           String?    @map("last_name")
  status             UserStatus @default(active)
  mfaRequired        Boolean    @default(true) @map("mfa_required")
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  memberships           OrganizationMembership[]
  createdDeals          Deal[]                    @relation("DealCreatedBy")
  createdDocuments       Document[]                @relation("DocumentCreatedBy")
  uploadedVersions       DocumentVersion[]
  grantedAccess          DocumentAccessGrant[]
  createdRequirementDefs RequirementDefinition[]   @relation("ReqDefCreatedBy")
  publishedRequirementDefs RequirementDefinition[] @relation("ReqDefPublishedBy")
  submissions            Submission[]              @relation("SubmittedByUser")
  attestedSubmissions    Submission[]              @relation("AttestedByUser")
  reviews                Review[]
  comments               Comment[]
  messages               Message[]
  assignedIssues         Issue[]
  issueNotes             IssueNote[]
  resolvedStructuredValues StructuredValue[]       @relation("StructuredValueEnteredBy")
  approvedStructuredValues StructuredValue[]       @relation("StructuredValueApprovedBy")
  createdSnapshots        SharedOutcomeSnapshot[]
  decidedSnapshotApprovals CdeSnapshotApproval[]
  generatedExports         ExportBatch[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  notificationSettings     UserNotificationSettings?
  auditEvents              AuditEvent[]

  @@map("users")
}

model OrganizationMembership {
  id             String           @id @default(uuid())
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String           @map("user_id")
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleCode       RoleCode         @map("role_code")
  status         MembershipStatus @default(active)
  createdAt      DateTime         @default(now()) @map("created_at")

  @@unique([organizationId, userId, roleCode])
  @@map("organization_memberships")
}

model Deal {
  id                     String     @id @default(uuid())
  dealCode               String     @unique @map("deal_code")
  legalName              String     @map("legal_name")
  projectName            String?    @map("project_name")
  projectDescription     String?    @map("project_description")
  closingDate            DateTime?  @map("closing_date") @db.Date
  complianceStartDate    DateTime?  @map("compliance_start_date") @db.Date
  complianceEndDate      DateTime?  @map("compliance_end_date") @db.Date
  fiscalYearEndMonth     Int        @default(12) @map("fiscal_year_end_month")
  fiscalYearEndDay       Int        @default(31) @map("fiscal_year_end_day")
  status                 DealStatus @default(onboarding)
  isMultiCde             Boolean    @default(false) @map("is_multi_cde")
  multiCdeProjectNumber  String?    @map("multi_cde_project_number")
  multiCdeAddressId      String?    @map("multi_cde_address_id")
  createdById            String?    @map("created_by")
  createdBy              User?      @relation("DealCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  organizationAccess    DealOrganizationAccess[]
  parties               DealParty[]
  cdeParticipations     CdeParticipation[]
  projectAddresses      ProjectAddress[]
  qlicis                Qlici[]
  documents              Document[]
  requirementDefinitions RequirementDefinition[]
  requirementInstances   RequirementInstance[]
  comments               Comment[]
  messages               Message[]
  impactTargets          ImpactTarget[]
  issues                 Issue[]
  issueNotes             IssueNote[]
  cbrReportingPeriods    CbrReportingPeriod[]
  sharedOutcomeSnapshots SharedOutcomeSnapshot[]
  structuredValues       StructuredValue[]
  exportBatches          ExportBatch[]
  notifications          Notification[]
  auditEvents            AuditEvent[]

  @@map("deals")
}

model DealOrganizationAccess {
  id                    String       @id @default(uuid())
  dealId                String       @map("deal_id")
  deal                  Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organizationId        String       @map("organization_id")
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dealRole              DealRole     @map("deal_role")
  canViewSharedEvidence Boolean      @default(false) @map("can_view_shared_evidence")
  canSubmit             Boolean      @default(false) @map("can_submit")
  canReview             Boolean      @default(false) @map("can_review")
  canApprove            Boolean      @default(false) @map("can_approve")
  canExport             Boolean      @default(false) @map("can_export")
  createdAt             DateTime     @default(now()) @map("created_at")

  @@unique([dealId, organizationId, dealRole])
  @@index([organizationId, dealId])
  @@map("deal_organization_access")
}

model DealParty {
  id                 String       @id @default(uuid())
  dealId             String       @map("deal_id")
  deal               Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organizationId     String?      @map("organization_id")
  organization       Organization? @relation(fields: [organizationId], references: [id])
  legalName          String       @map("legal_name")
  partyRole          PartyRole    @map("party_role")
  isReportingParty   Boolean      @default(false) @map("is_reporting_party")
  fiscalYearEndMonth Int?         @map("fiscal_year_end_month")
  fiscalYearEndDay   Int?         @map("fiscal_year_end_day")
  naicsCode          String?      @map("naics_code")
  entityType         String?      @map("entity_type")
  activeFrom         DateTime?    @map("active_from") @db.Date
  activeTo           DateTime?    @map("active_to") @db.Date
  metadata           Json         @default("{}")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  documents             Document[]
  requirementInstances   RequirementInstance[]
  structuredValues       StructuredValue[]
  employerJobRecords      JobRecord[]
  employerBenefitRecords  BenefitRecord[]
  tenantOccupancies       TenantOccupant[]

  @@index([dealId, partyRole])
  @@map("deal_parties")
}

model CdeParticipation {
  id                       String       @id @default(uuid())
  dealId                   String       @map("deal_id")
  deal                     Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  cdeOrganizationId        String       @map("cde_organization_id")
  cdeOrganization          Organization @relation("CdeOrg", fields: [cdeOrganizationId], references: [id])
  allocateeOrganizationId  String?      @map("allocatee_organization_id")
  allocateeOrganization    Organization? @relation("AllocateeOrg", fields: [allocateeOrganizationId], references: [id])
  subCdeName               String?      @map("sub_cde_name")
  allocationControlNumber  String?      @map("allocation_control_number")
  qeiAmount                Decimal?     @map("qei_amount") @db.Decimal(18, 2)
  allocationAmount         Decimal?     @map("allocation_amount") @db.Decimal(18, 2)
  isLeadCde                Boolean      @default(false) @map("is_lead_cde")
  privateSettings          Json         @default("{}") @map("private_settings")
  createdAt                DateTime     @default(now()) @map("created_at")

  qlicis                    Qlici[]
  shareSnapshotsControlled  SharedOutcomeSnapshot[]
  snapshotApprovals         CdeSnapshotApproval[]
  exportBatches              ExportBatch[]

  @@unique([dealId, cdeOrganizationId])
  @@map("cde_participations")
}

model ProjectAddress {
  id               String   @id @default(uuid())
  dealId           String   @map("deal_id")
  deal             Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  addressType      String   @default("primary") @map("address_type") // primary | secondary | service_area | other
  address1         String
  address2         String?
  city             String
  stateCode        String   @map("state_code") @db.Char(2)
  postalCode       String   @map("postal_code")
  postalCodePlus4  String?  @map("postal_code_plus4")
  county           String?
  censusTract      String?  @map("census_tract")
  longitude        Decimal? @db.Decimal(12, 8)
  latitude         Decimal? @db.Decimal(11, 8)
  cimsAddressId    String?  @map("cims_address_id")
  eligibilityData  Json     @default("{}") @map("eligibility_data")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("project_addresses")
}

model Qlici {
  id                 String       @id @default(uuid())
  dealId             String       @map("deal_id")
  deal               Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  cdeParticipationId String       @map("cde_participation_id")
  cdeParticipation   CdeParticipation @relation(fields: [cdeParticipationId], references: [id], onDelete: Cascade)
  qliciCode          String       @map("qlici_code")
  qliciType          QliciType    @default(loan) @map("qlici_type")
  noteClass          String?      @map("note_class")
  originalPrincipal  Decimal?     @map("original_principal") @db.Decimal(18, 2)
  currentPrincipal   Decimal?     @map("current_principal") @db.Decimal(18, 2)
  interestRate       Decimal?     @map("interest_rate") @db.Decimal(9, 6)
  maturityDate       DateTime?    @map("maturity_date") @db.Date
  qliciDate          DateTime?    @map("qlici_date") @db.Date
  status             QliciStatus  @default(active)
  createdAt          DateTime     @default(now()) @map("created_at")

  disbursements      Disbursement[]
  structuredValues   StructuredValue[]

  @@unique([dealId, cdeParticipationId, qliciCode])
  @@map("qlicis")
}

// A draw of QEI proceeds into a QLICI note. This is the fourth object in an AMIS TLR
// upload (tlr_disbursement__c) and had no representation in the platform at all, so those
// eight fields previously had nowhere to live.
//
// It hangs off the QLICI rather than the deal because that is how AMIS joins the two
// sheets: the disbursement's "Originator Transaction ID" is the note's, which is why that
// column isn't stored here — it would be a second, driftable copy of qlici.qliciCode.
//
// One note can draw from several QEIs. The sample workbook has 14 disbursements citing
// five distinct QEI names, which is why qeiName lives here per-draw rather than on
// CdeParticipation — that model carries a single qeiAmount and cannot express the split.
// It is a plain AMIS identifier string ("QEI00014512") and not a relation, because the
// platform has no QEI entity, and inventing one to satisfy a report would claim far more
// modelling than a TLR actually requires.
//
// The remaining two TLR columns are deliberately absent. "Result" and "Record Type of New
// Record" are transport artifacts of one upload attempt, not facts about the disbursement,
// so they belong to export lineage rather than here.
model Disbursement {
  id               String    @id @default(uuid())
  qliciId          String    @map("qlici_id")
  qlici            Qlici     @relation(fields: [qliciId], references: [id], onDelete: Cascade)
  qeiName          String?   @map("qei_name")
  disbursementDate DateTime? @map("disbursement_date") @db.Date
  sourceAmount     Decimal?  @map("source_amount") @db.Decimal(18, 2)
  isRevolving      Boolean   @default(false) @map("is_revolving")
  // Assigned by AMIS when the record lands, so it is blank in an export we generate and
  // populated in one we download. Keeping it is what makes a later upload an update of an
  // existing record rather than a duplicate insert.
  amisNumber       String?   @map("amis_number")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([qliciId])
  @@map("disbursements")
}

// ---------- Evidence & Data ----------

model Document {
  id                    String         @id @default(uuid())
  dealId                String?        @map("deal_id")
  deal                  Deal?          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  ownerOrganizationId   String?        @map("owner_organization_id")
  ownerOrganization     Organization?  @relation(fields: [ownerOrganizationId], references: [id])
  documentType          String         @map("document_type")
  title                 String
  legalEntityPartyId    String?        @map("legal_entity_party_id")
  legalEntityParty      DealParty?     @relation(fields: [legalEntityPartyId], references: [id])
  reportingPeriodStart  DateTime?      @map("reporting_period_start") @db.Date
  reportingPeriodEnd    DateTime?      @map("reporting_period_end") @db.Date
  shareScope            ShareScope     @default(impact_only) @map("share_scope")
  status                DocumentStatus @default(active)
  currentVersion        Int            @default(1) @map("current_version")
  createdById           String?        @map("created_by")
  createdBy             User?          @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  versions             DocumentVersion[]
  accessGrants          DocumentAccessGrant[]
  requirementSources     RequirementSource[]
  submissionLinks        SubmissionDocument[]
  structuredValues        StructuredValue[]
  jobRecordSources         JobRecord[]
  exportFieldLineage        ExportFieldLineage[]

  @@index([dealId, documentType, reportingPeriodEnd])
  @@map("documents")
}

model DocumentVersion {
  id                  String    @id @default(uuid())
  documentId          String    @map("document_id")
  document            Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber       Int       @map("version_number")
  s3Bucket            String    @map("s3_bucket")
  s3ObjectKey         String    @map("s3_object_key")
  s3VersionId         String?   @map("s3_version_id")
  fileName            String    @map("file_name")
  mimeType            String?   @map("mime_type")
  fileSizeBytes       BigInt?   @map("file_size_bytes")
  sha256Checksum      String    @map("sha256_checksum")
  kmsKeyArn           String?   @map("kms_key_arn")
  malwareScanStatus   MalwareScanStatus @default(pending) @map("malware_scan_status")
  uploadedById        String?   @map("uploaded_by")
  uploadedBy          User?     @relation(fields: [uploadedById], references: [id])
  uploadedAt          DateTime  @default(now()) @map("uploaded_at")
  supersededAt        DateTime? @map("superseded_at")

  structuredValueSources StructuredValue[]

  @@unique([documentId, versionNumber])
  @@unique([s3Bucket, s3ObjectKey, s3VersionId])
  @@map("document_versions")
}

model DocumentAccessGrant {
  id             String               @id @default(uuid())
  documentId     String               @map("document_id")
  document       Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organizationId String               @map("organization_id")
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accessLevel    DocumentAccessLevel  @default(view) @map("access_level")
  grantedById    String?              @map("granted_by")
  grantedBy      User?                @relation(fields: [grantedById], references: [id])
  grantedAt      DateTime             @default(now()) @map("granted_at")
  revokedAt      DateTime?            @map("revoked_at")

  @@unique([documentId, organizationId])
  @@map("document_access_grants")
}

// ---------- Requirements & Workflow ----------

model RequirementDefinition {
  id                    String                @id @default(uuid())
  dealId                String                @map("deal_id")
  deal                  Deal                  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  requirementCode       String                @map("requirement_code")
  version               Int
  title                 String
  category              RequirementCategory
  cadence               RequirementCadence
  appliesToPartyRoles   String[]              @default([]) @map("applies_to_party_roles")
  dueRule               Json                  @map("due_rule")
  evidenceSchema        Json                  @default("{}") @map("evidence_schema")
  validationRules       Json                  @default("[]") @map("validation_rules")
  reviewWorkflow        Json                  @default("[]") @map("review_workflow")
  reminderRule          Json                  @default("{}") @map("reminder_rule")
  shareScope            String                @default("deal_shared") @map("share_scope")
  severity              Severity              @default(normal)
  effectiveFrom         DateTime?             @map("effective_from") @db.Date
  effectiveTo           DateTime?             @map("effective_to") @db.Date
  status                RequirementDefStatus  @default(draft)
  conflictStatus        ConflictStatus        @default(none) @map("conflict_status")
  conflictResolutionNote String?              @map("conflict_resolution_note")
  createdById           String?               @map("created_by")
  createdBy             User?                 @relation("ReqDefCreatedBy", fields: [createdById], references: [id])
  publishedById         String?               @map("published_by")
  publishedBy           User?                 @relation("ReqDefPublishedBy", fields: [publishedById], references: [id])
  publishedAt           DateTime?             @map("published_at")
  createdAt             DateTime              @default(now()) @map("created_at")

  sources    RequirementSource[]
  instances  RequirementInstance[]

  @@unique([dealId, requirementCode, version])
  @@index([dealId, status])
  @@map("requirement_definitions")
}

model RequirementSource {
  id                       String                 @id @default(uuid())
  requirementDefinitionId  String                 @map("requirement_definition_id")
  requirementDefinition    RequirementDefinition  @relation(fields: [requirementDefinitionId], references: [id], onDelete: Cascade)
  sourceDocumentId         String?                @map("source_document_id")
  sourceDocument           Document?              @relation(fields: [sourceDocumentId], references: [id])
  sourceDocumentName       String                 @map("source_document_name")
  sectionReference         String?                @map("section_reference")
  exhibitReference         String?                @map("exhibit_reference")
  pageReference             String?                @map("page_reference")
  sourceExcerpt              String?                @map("source_excerpt")
  sourceExcerptHash           String?                @map("source_excerpt_hash")
  sourceEffectiveDate          DateTime?              @map("source_effective_date") @db.Date
  sourcePriority                 Int                    @default(100) @map("source_priority")

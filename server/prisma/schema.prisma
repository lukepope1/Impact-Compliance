// The impact measures a deal commits to at closing and reports against afterward. Each
// one maps to an actual this app already collects on the CBR, so "committed vs actual"
// compares like with like:
//   permanent_jobs    <- JobRecord.fteCount where jobStatus = created
//   retained_jobs     <- JobRecord.fteCount where jobStatus = retained
//   construction_jobs <- JobRecord.fteCount where jobStatus = construction
//   lmi_jobs          <- JobRecord.fteCount where accessibleToLicLip
//   people_served     <- ServiceOutcome.peopleServedCurrent
//   square_feet       <- ServiceOutcome.squareFeet + TenantOccupant.squareFeet
//
// Deliberately no "quality jobs" member: it's a real NMTC concept but has no agreed
// definition in this system (a wage floor? benefits threshold? both?), and the fields that
// would feed it — hourlyWage, benefitsBurdenPercent, employeesEligibleHealthcare — are
// collected without any threshold to test them against. Adding the member before the
// definition exists would mean computing an actual nobody could defend.
enum ImpactMetric {
  permanent_jobs
  retained_jobs
  construction_jobs
  lmi_jobs
  people_served
  square_feet
}


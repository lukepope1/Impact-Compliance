  requirementDefinitionId   String                    @map("requirement_definition_id")
  requirementDefinition     RequirementDefinition     @relation(fields: [requirementDefinitionId], references: [id])
  definitionVersion         Int                       @map("definition_version")
  responsiblePartyId        String?                   @map("responsible_party_id")
  responsibleParty          DealParty?                @relation(fields: [responsiblePartyId], references: [id])
  reportingPeriodStart      DateTime?                 @map("reporting_period_start") @db.Date
  reportingPeriodEnd        DateTime?                 @map("reporting_period_end") @db.Date
  dueDate                   DateTime?                 @map("due_date") @db.Date
  dueDateBasis               Json                      @default("{}") @map("due_date_basis")
  requestedAt                 DateTime?                 @map("requested_at")
  status                       RequirementInstanceStatus @default(not_due)
  isOverdue                     Boolean                   @default(false) @map("is_overdue")
  isException                     Boolean                   @default(false) @map("is_exception")
  currentSubmissionVersion          Int                       @default(0) @map("current_submission_version")
  createdAt                           DateTime                  @default(now()) @map("created_at")
  updatedAt                             DateTime                  @updatedAt @map("updated_at")

  submissions  Submission[]
  reviews      Review[]
  comments     Comment[]
  messages     Message[]
  issues       Issue[]
  notifications Notification[]

  @@unique([requirementDefinitionId, responsiblePartyId, reportingPeriodStart, reportingPeriodEnd, dueDate])
  @@index([dealId, dueDate, status])
  @@index([responsiblePartyId, dueDate])
  @@map("requirement_instances")
}


  fieldDefinitionId  String?  @map("field_definition_id")
  fieldDefinition    FieldDefinition? @relation(fields: [fieldDefinitionId], references: [id])
  amisObject         String   @map("amis_object")
  amisFieldName      String   @map("amis_field_name")
  transformRule      String?  @map("transform_rule")
  conditionalRule    String?  @map("conditional_rule")
  validationRules    Json     @default("[]") @map("validation_rules")
  sourcePreference   Json     @default("[]") @map("source_preference")
  approvalRole       String?  @map("approval_role")
  sortOrder          Int      @default(1000) @map("sort_order")

  exportFieldLineage ExportFieldLineage[]

  @@unique([mappingVersionId, amisObject, amisFieldName])
  @@map("amis_field_mappings")
}

model ExportBatch {
  id                 String       @id @default(uuid())
  dealId             String?      @map("deal_id")
  deal               Deal?        @relation(fields: [dealId], references: [id])
  cdeParticipationId String?      @map("cde_participation_id")
  cdeParticipation   CdeParticipation? @relation(fields: [cdeParticipationId], references: [id])
  mappingVersionId   String       @map("mapping_version_id")
  mappingVersion     AmisMappingVersion @relation(fields: [mappingVersionId], references: [id])
  reportingPeriodEnd DateTime?    @map("reporting_period_end") @db.Date
  exportType         ExportType   @map("export_type")
  status             ExportStatus @default(building)
  s3Bucket           String?      @map("s3_bucket")
  s3ObjectKey        String?      @map("s3_object_key")
  fileName           String?      @map("file_name")
  fileChecksum       String?      @map("file_checksum")
  validationResults  Json         @default("[]") @map("validation_results")
  generatedById      String?      @map("generated_by")
  generatedBy        User?        @relation(fields: [generatedById], references: [id])
  generatedAt        DateTime     @default(now()) @map("generated_at")
  filedAt            DateTime?    @map("filed_at")
  certifiedAt        DateTime?    @map("certified_at")

  fieldLineage ExportFieldLineage[]

  @@index([dealId, status, generatedAt(sort: Desc)])
  @@map("export_batches")
}

model ExportFieldLineage {
  id                     String   @id @default(uuid())
  exportBatchId          String   @map("export_batch_id")
  exportBatch            ExportBatch @relation(fields: [exportBatchId], references: [id], onDelete: Cascade)
  amisFieldMappingId     String   @map("amis_field_mapping_id")
  amisFieldMapping       AmisFieldMapping @relation(fields: [amisFieldMappingId], references: [id])
  outputRowKey           String?  @map("output_row_key")
  outputFieldName        String   @map("output_field_name")
  outputValue            String?  @map("output_value")
  sourceStructuredValueId String? @map("source_structured_value_id")
  sourceStructuredValue   StructuredValue? @relation(fields: [sourceStructuredValueId], references: [id])
  sourceSnapshotValueId   String? @map("source_snapshot_value_id")
  sourceSnapshotValue     SharedOutcomeValue? @relation(fields: [sourceSnapshotValueId], references: [id])
  sourceDocumentId        String? @map("source_document_id")
  sourceDocument          Document? @relation(fields: [sourceDocumentId], references: [id])
  sourceReviewId          String? @map("source_review_id")
  sourceReview            Review? @relation(fields: [sourceReviewId], references: [id])
  createdAt               DateTime @default(now()) @map("created_at")

  @@map("export_field_lineage")
}

// ---------- Notifications & Audit ----------

model Notification {
  id                     String   @id @default(uuid())
  userId                 String?  @map("user_id")
  user                   User?    @relation(fields: [userId], references: [id])
  organizationId         String?  @map("organization_id")
  organization           Organization? @relation(fields: [organizationId], references: [id])
  dealId                 String?  @map("deal_id")
  deal                   Deal?    @relation(fields: [dealId], references: [id])
  requirementInstanceId  String?  @map("requirement_instance_id")
  requirementInstance    RequirementInstance? @relation(fields: [requirementInstanceId], references: [id])
  notificationType       String   @map("notification_type")
  channel                NotificationChannel
  subject                String?
  body                   String?
  scheduledFor           DateTime? @map("scheduled_for")
  sentAt                 DateTime? @map("sent_at")
  status                 NotificationStatus @default(queued)
  providerMessageId      String?  @map("provider_message_id")
  // In-app "read" tracking — distinct from status/sentAt, which describe delivery
  // (queued/sent/failed), not whether the recipient has seen it in the notification list.
  readAt                 DateTime? @map("read_at")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

// Per-user opt-out of a notification event type on a specific channel. Absence of a row
// means "enabled" (opt-out model, not opt-in) — preserves today's behavior of "everyone
// eligible gets everything" for anyone who never visits the preferences screen, while
// letting a user quiet a specific event/channel combination. eventType values are the
// fixed catalog in server/src/lib/notificationPreferences.ts, not the raw (sometimes
// stage-prefixed) notificationType strings notify() writes to Notification.notificationType.
model NotificationPreference {
  id         String              @id @default(uuid())
  userId     String              @map("user_id")
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventType  String              @map("event_type")
  channel    NotificationChannel
  enabled    Boolean             @default(true)
  updatedAt  DateTime            @updatedAt @map("updated_at")

  @@unique([userId, eventType, channel])
  @@map("notification_preferences")
}

enum EmailDigestFrequency {
  immediate
  daily
}

// A user's email delivery timing — separate from NotificationPreference (which is a
// per-event on/off) since digest mode is a single cross-event setting: "batch all my
// enabled-channel email into one daily message" vs. "send each one as it happens." A
// missing row means "immediate," matching today's behavior for anyone who never visits
// the settings screen.
model UserNotificationSettings {
  id                   String               @id @default(uuid())
  userId               String               @unique @map("user_id")
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailDigestFrequency EmailDigestFrequency @default(immediate) @map("email_digest_frequency")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@map("user_notification_settings")
}

model AuditEvent {
  id                   String   @id @default(uuid())
  occurredAt           DateTime @default(now()) @map("occurred_at")
  actorUserId          String?  @map("actor_user_id")
  actorUser            User?    @relation(fields: [actorUserId], references: [id])
  actorOrganizationId  String?  @map("actor_organization_id")
  actorOrganization    Organization? @relation(fields: [actorOrganizationId], references: [id])
  dealId               String?  @map("deal_id")
  deal                 Deal?    @relation(fields: [dealId], references: [id])
  objectType           String   @map("object_type")
  objectId             String?  @map("object_id")
  action               String
  beforeData           Json?    @map("before_data")
  afterData            Json?    @map("after_data")
  requestId            String?  @map("request_id")
  ipAddress            String?  @map("ip_address")
  userAgent            String?  @map("user_agent")
  metadata             Json     @default("{}")

  @@index([dealId, occurredAt(sort: Desc)])
  @@index([objectType, objectId, occurredAt(sort: Desc)])
  @@map("audit_events")
}

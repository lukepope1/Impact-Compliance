  unit           String?
  optionValues   Json?         @map("option_values")
  validation     Json          @default("{}")
  status         String        @default("active") // active | retired

  structuredValues     StructuredValue[]
  sharedOutcomeValues  SharedOutcomeValue[]
  amisFieldMappings    AmisFieldMapping[]

  @@unique([fieldCode, version])
  @@map("field_definitions")
}

model StructuredValue {
  id                       String            @id @default(uuid())
  dealId                   String            @map("deal_id")
  deal                     Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fieldDefinitionId        String            @map("field_definition_id")
  fieldDefinition          FieldDefinition   @relation(fields: [fieldDefinitionId], references: [id])
  // Which QLICI this value describes, for the note-level fields of a TLR — 61 of its 205
  // columns are reported once per note, not once per deal. Null means the value is
  // deal-level, which is every value written before this existed and remains the common
  // case, so the column is nullable rather than a second required scope.
  //
  // dealId stays required and authoritative even when qliciId is set, so that deal-scoped
  // access checks and queries keep working unchanged. That does mean the two could
  // disagree, which no constraint here can prevent — whatever writes a note-level value
  // must confirm the QLICI belongs to dealId first.
  qliciId                  String?           @map("qlici_id")
  qlici                    Qlici?            @relation(fields: [qliciId], references: [id], onDelete: Cascade)
  reportingPartyId         String?           @map("reporting_party_id")
  reportingParty           DealParty?        @relation(fields: [reportingPartyId], references: [id])
  reportingPeriodStart     DateTime?         @map("reporting_period_start") @db.Date
  reportingPeriodEnd       DateTime?         @map("reporting_period_end") @db.Date
  valueText                String?           @map("value_text")
  valueNumber               Decimal?          @map("value_number") @db.Decimal(24, 8)
  valueBoolean                Boolean?          @map("value_boolean")
  valueDate                     DateTime?         @map("value_date") @db.Date
  valueJson                       Json?             @map("value_json")
  sourceSubmissionId                 String?           @map("source_submission_id")
  sourceSubmission                     Submission?       @relation(fields: [sourceSubmissionId], references: [id])
  sourceDocumentId                       String?           @map("source_document_id")
  sourceDocument                           Document?         @relation(fields: [sourceDocumentId], references: [id])
  sourceDocumentVersionId                     String?           @map("source_document_version_id")
  sourceDocumentVersion                         DocumentVersion?  @relation(fields: [sourceDocumentVersionId], references: [id])
  enteredById                                     String?           @map("entered_by")
  enteredBy                                         User?             @relation("StructuredValueEnteredBy", fields: [enteredById], references: [id])
  entryMethod                                         EntryMethod       @default(manual) @map("entry_method")
  validationStatus                                      ValidationStatus  @default(unreviewed) @map("validation_status")
  approvedById                                            String?           @map("approved_by")
  approvedBy                                                User?             @relation("StructuredValueApprovedBy", fields: [approvedById], references: [id])
  approvedAt                                                  DateTime?         @map("approved_at")
  supersededById                                                String?           @unique @map("superseded_by")
  supersededBy                                                    StructuredValue?  @relation("SupersededChain", fields: [supersededById], references: [id])
  supersedes                                                        StructuredValue?  @relation("SupersededChain")
  createdAt                                                           DateTime          @default(now()) @map("created_at")

  exportFieldLineage ExportFieldLineage[]

  @@index([dealId, fieldDefinitionId, reportingPeriodEnd])
  @@index([qliciId, fieldDefinitionId, reportingPeriodEnd])
  @@map("structured_values")
}

model Review {
  id                     String              @id @default(uuid())
  requirementInstanceId  String              @map("requirement_instance_id")
  requirementInstance    RequirementInstance @relation(fields: [requirementInstanceId], references: [id], onDelete: Cascade)
  submissionId           String?             @map("submission_id")
  submission             Submission?         @relation(fields: [submissionId], references: [id])
  reviewStage            ReviewStage         @map("review_stage")
  reviewingOrganizationId String             @map("reviewing_organization_id")
  reviewerUserId          String             @map("reviewer_user_id")
  reviewerUser             User               @relation(fields: [reviewerUserId], references: [id])
  decision                   ReviewDecision     @map("decision")
  decisionNote                  String?            @map("decision_note")
  decidedAt                       DateTime           @default(now()) @map("decided_at")

  exportFieldLineage ExportFieldLineage[]

  @@index([requirementInstanceId, reviewStage, decidedAt(sort: Desc)])
  @@map("reviews")
}

model Comment {
  id                    String              @id @default(uuid())
  dealId                String              @map("deal_id")
  deal                  Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  requirementInstanceId String?             @map("requirement_instance_id")
  requirementInstance   RequirementInstance? @relation(fields: [requirementInstanceId], references: [id], onDelete: Cascade)
  submissionId          String?             @map("submission_id")
  submission            Submission?         @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorUserId          String              @map("author_user_id")
  authorUser            User                @relation(fields: [authorUserId], references: [id])
  authorOrganizationId  String              @map("author_organization_id")
  authorOrganization    Organization        @relation(fields: [authorOrganizationId], references: [id])
  visibility            CommentVisibility
  body                  String
  createdAt             DateTime            @default(now()) @map("created_at")
  editedAt               DateTime?           @map("edited_at")

  @@map("comments")
}

// A lightweight request/response thread between deal parties — distinct from Comment
// (which is a flat note attached to one requirement instance) in that a Message thread
// has its own due date/SLA and an explicit Open/Returned/Closed lifecycle, matching how
// an actual lender/CDE information request is tracked, not just discussed. Replies are
// Message rows with parentMessageId set; only the root row's subject/dueDate/status are
// meaningful — see messages.ts for the status-transition rules.
model Message {
  id                    String              @id @default(uuid())
  dealId                String              @map("deal_id")
  deal                  Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  parentMessageId       String?             @map("parent_message_id")
  parentMessage         Message?            @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: Cascade)
  replies               Message[]           @relation("MessageReplies")
  requirementInstanceId String?             @map("requirement_instance_id")
  requirementInstance   RequirementInstance? @relation(fields: [requirementInstanceId], references: [id])
  fromUserId            String              @map("from_user_id")
  fromUser              User                @relation(fields: [fromUserId], references: [id])
  fromOrganizationId    String              @map("from_organization_id")
  fromOrganization      Organization        @relation(fields: [fromOrganizationId], references: [id])
  visibility            MessageVisibility
  subject               String?
  body                  String
  dueDate               DateTime?           @map("due_date") @db.Date
  slaDays               Int?                @map("sla_days")
  status                MessageStatus       @default(open)
  // Set the first time the overdue sweep alerts on this thread, so a thread that stays
  // open past its response date is called out once rather than every hourly tick. Unlike
  // RequirementInstance.isOverdue this isn't a derived display flag — a thread's due date
  // never moves once set, so "is it overdue" is computable at read time and this column
  // only records that we already said so.
  overdueNotifiedAt     DateTime?           @map("overdue_notified_at")
  createdAt             DateTime            @default(now()) @map("created_at")

  @@index([dealId, parentMessageId, createdAt])
  @@map("messages")
}

// What a deal committed to deliver, per measure — the "487 projected" half of a board
// report. Set once from the allocation agreement / QEI application rather than reported
// periodically, which is why it hangs off the deal and not off a CBR period: the
// commitment doesn't change year to year, only the actuals reported against it do.
//
// sourceNote records where the figure came from, matching how RequirementSource makes
// every requirement traceable to a document and section — a committed number that can't
// be traced back is a number nobody will defend in front of a board.
model ImpactTarget {
  id             String       @id @default(uuid())
  dealId         String       @map("deal_id")
  deal           Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  metric         ImpactMetric
  committedValue Decimal      @map("committed_value") @db.Decimal(18, 2)
  sourceNote     String?      @map("source_note")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([dealId, metric])
  @@map("impact_targets")
}

model Issue {
  id                        String       @id @default(uuid())
  dealId                    String       @map("deal_id")
  deal                      Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  requirementInstanceId     String?      @map("requirement_instance_id")
  requirementInstance       RequirementInstance? @relation(fields: [requirementInstanceId], references: [id])
  issueType                 IssueType    @map("issue_type")
  severity                  Severity
  title                     String
  description               String?
  assignedToUserId          String?      @map("assigned_to_user_id")
  assignedToUser             User?        @relation(fields: [assignedToUserId], references: [id])
  assignedToOrganizationId    String?      @map("assigned_to_organization_id")
  assignedToOrganization        Organization? @relation(fields: [assignedToOrganizationId], references: [id])
  status                          IssueStatus  @default(open)
  dueDate                             DateTime?    @map("due_date") @db.Date
  resolution                            String?
  resolvedAt                              DateTime?    @map("resolved_at")
  createdAt                                 DateTime     @default(now()) @map("created_at")
  updatedAt                                   DateTime     @updatedAt @map("updated_at")

  notes                     IssueNote[]

  @@index([dealId, status, severity])
  @@map("issues")
}

enum IssueNoteVisibility {
  org_private
  deal_shared
}

// Private notes on an issue, distinct from its public title/description — a CDE
// (or QALICB, or Impact) can jot something down that isn't meant for every other org
// with deal access. org_private means "only the authoring org and Impact can see this,"
// not "shared with every CDE on the deal" — scoped to the specific authoring
// organization, matching how documentAccess.ts's cde_private grants work (per-org, not
// per-org-type), not comments.ts's broader same-org-type check.
model IssueNote {
  id                   String              @id @default(uuid())
  issueId              String              @map("issue_id")
  issue                Issue               @relation(fields: [issueId], references: [id], onDelete: Cascade)
  dealId               String              @map("deal_id")
  deal                 Deal                @relation(fields: [dealId], references: [id], onDelete: Cascade)
  authorUserId         String              @map("author_user_id")
  authorUser           User                @relation(fields: [authorUserId], references: [id])
  authorOrganizationId String              @map("author_organization_id")
  authorOrganization   Organization        @relation(fields: [authorOrganizationId], references: [id])
  visibility           IssueNoteVisibility @default(org_private)
  body                 String
  createdAt            DateTime            @default(now()) @map("created_at")

  @@index([issueId, createdAt])
  @@map("issue_notes")
}


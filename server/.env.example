# Postgres connection for the compliance platform's own database.
# Must NOT point at the CRM database — this product owns a separate schema entirely.
DATABASE_URL="postgresql://user:password@localhost:5432/nmtc_compliance?schema=public"

PORT=4100
CLIENT_ORIGIN="http://localhost:5173"

# Placeholder for the identity provider (AWS Cognito or equivalent). Phase 1 auth
# middleware trusts a decoded subject claim; wire the real verifier here before go-live.
AUTH_JWT_ISSUER=""
AUTH_JWT_AUDIENCE=""

# S3 evidence storage (private bucket, SSE-KMS). Required from Phase 2 onward.
AWS_REGION=""
EVIDENCE_S3_BUCKET=""
EVIDENCE_KMS_KEY_ARN=""
